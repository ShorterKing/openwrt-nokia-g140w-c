 	jiofiber,jcow414)
 		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
 		;;
-	nokia,g140w-c)
+	nokia,g140w-c|\
+	nokia,g140w-c-bringup)
 		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "lan4"
 		# econet-eth has no checksum or scatter-gather offload, so GRO
