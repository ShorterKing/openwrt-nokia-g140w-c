From e4965a35a16e33ae3761c27b74915aa492156d70 Mon Sep 17 00:00:00 2001
From: ShorterKing <84120105+ShorterKing@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:15:37 +0000
Subject: [PATCH 2/2] econet: add support for Nokia G-140W-C

The Nokia G-140W-C is a GPON ONT with four gigabit LAN ports and
dual-band Wi-Fi, supplied by Airtel in India.

Hardware:
 - SoC: EcoNet EN7526G (EN751221 family), MIPS 34Kc, 2 threads, 900 MHz
 - RAM: 512 MiB DDR3 (Linux can use the first 0x1b800000 bytes)
 - Flash: 256 MiB SPI-NAND (Winbond W25M02GV) with the vendor BMT
 - Ethernet: 4x 1 GbE on switch ports 1-4
 - Wi-Fi 2.4 GHz: MT7592 (mt7603) on PCIe RC0
 - Wi-Fi 5 GHz: MT7612E (mt76x2) on PCIe RC1
 - USB: xHCI
 - LEDs: power, PON, LOS, Internet, phone and USB on GPIOs; 2.4 GHz
   WLAN on the MT7592 LED pin
 - Buttons: reset (GPIO 0), LED on/off (GPIO 5)
 - Serial: 115200 8N1

Not supported: GPON and VoIP (closed vendor drivers).

The flash layout and bootloader match the Nokia G-240G-E. OpenWrt goes
into firmware slot A ("tclinux"): a 4 MiB TRX kernel followed by UBI.
Stock stays in slot B, and en75_chboot switches between them. LAN4 is
the WAN port.

A bring-up variant (RAM boot only) leaves the switch unmanaged and
checks the vendor BMT pool size before touching the bad-block table.

Installation: not final yet. So far the images have only been tested by
loading the initramfs kernel through the bootloader's XMODEM command.
---
 .../econet/base-files/etc/board.d/02_network  |   9 +
 .../econet/base-files/lib/upgrade/platform.sh |   6 +-
 .../linux/econet/base-files/sbin/en75_chboot  |  13 +
 .../dts/en751221_nokia_g140w-c-bringup.dts    |  19 +
 .../econet/dts/en751221_nokia_g140w-c.dts     | 120 ++++++
 .../econet/dts/en751221_nokia_g140w-c.dtsi    | 356 ++++++++++++++++++
 target/linux/econet/image/en751221.mk         |  27 ++
 7 files changed, 548 insertions(+), 2 deletions(-)
 create mode 100644 target/linux/econet/dts/en751221_nokia_g140w-c-bringup.dts
 create mode 100644 target/linux/econet/dts/en751221_nokia_g140w-c.dts
 create mode 100644 target/linux/econet/dts/en751221_nokia_g140w-c.dtsi

diff --git a/target/linux/econet/base-files/etc/board.d/02_network b/target/linux/econet/base-files/etc/board.d/02_network
index 8bb6b25b0b..7cb7e66a18 100644
--- a/target/linux/econet/base-files/etc/board.d/02_network
+++ b/target/linux/econet/base-files/etc/board.d/02_network
@@ -14,6 +14,9 @@ econet_setup_interfaces()
 	jiofiber,jcow414)
 		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
 		;;
+	nokia,g140w-c)
+		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "lan4"
+		;;
 	*)
 		# The remaining boards have no DSA switch driver yet.
 		ucidef_set_interface_lan "eth0"
@@ -33,6 +36,12 @@ econet_setup_macs()
 		wan_mac="$(get_mac_gs3101)"
 		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
 		;;
+	nokia,g140w-c|\
+	nokia,g140w-c-bringup)
+		label_mac="$(mtd_get_mac_binary ri 0x3e)"
+		lan_mac="$label_mac"
+		wan_mac="$(macaddr_add "$label_mac" 1)"
+		;;
 	huawei,hg2821t-u)
 		local conffile="/tmp/configuration_a/factory.conf"
 		lan_mac=$(get_mac_ascii "$conffile" brmac)
diff --git a/target/linux/econet/base-files/lib/upgrade/platform.sh b/target/linux/econet/base-files/lib/upgrade/platform.sh
