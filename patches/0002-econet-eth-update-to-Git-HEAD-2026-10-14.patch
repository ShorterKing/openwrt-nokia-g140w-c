-PKG_SOURCE_DATE:=2026-07-21
-PKG_SOURCE_VERSION:=3ba0abe30cfa0dc1e76e41218140bc061be131fb
+PKG_MIRROR_HASH:=bff591f0388dc68573f0be7b9b2af6887850382cf03b4f7c5e247efbab30e437
+PKG_SOURCE_DATE:=2026-10-14
