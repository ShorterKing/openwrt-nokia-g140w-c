 package/kernel/econet-eth/Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/package/kernel/econet-eth/Makefile b/package/kernel/econet-eth/Makefile
index f3c7c37d7e..de07827a2c 100644
