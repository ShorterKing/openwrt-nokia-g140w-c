diff --git a/target/linux/econet/dts/en751221_nokia_g140w-c.dtsi b/target/linux/econet/dts/en751221_nokia_g140w-c.dtsi
new file mode 100644
index 0000000000..6dc94c0ebf
--- /dev/null
+++ b/target/linux/econet/dts/en751221_nokia_g140w-c.dtsi
@@ -0,0 +1,433 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Nokia G-140W-C (EcoNet EN7526G, 512 MiB DDR3, 256 MiB SPI-NAND W25M02GV,
+ * MT7592 + MT7612E)
+ *
+ * Everything shared by the production and RAM-test device trees.
+ * Derived from en751221_nokia_g240g-e.dts, which has an identical flash
+ * layout. Items marked TODO must be verified on hardware.
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "en751221.dtsi"
+
+/ {
+	/*
+	 * 512 MiB DDR3 fitted, but only the part below the 0x1c000000 I/O
+	 * window is reachable; the stock kernel uses 0x0-0x1b800000 (440 MiB).
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x1b800000>;
+	};
+
+	chosen {
+		stdout-path = "/serial@1fbf0000:115200";
+		linux,usable-memory-range = <0x00020000 0x1b7e0000>;
+	};
+
+	aliases {
+		led-boot = &led_power;
+		led-failsafe = &led_red;
+		led-running = &led_power;
+		led-upgrade = &led_pon;
+	};
+
+	/*
+	 * The stock led_drv.ko/gpio_mgr.ko have a table for this board
+	 * ("G140WC"): power GPIO 6, PON GPIO 2, LOS GPIO 24, Internet GPIO 28,
+	 * phone GPIO 25 (LED id 9, used by the SIP app) and USB GPIO 11 (LED
+	 * ids 15/67, used by the USB notifier). All active-low; each one was
+	 * lit from Linux and matched to its D-number on the PCB. GPIO 27 is the
+	 * PON laser TX-disable line and must stay alone. The 2.4 GHz WLAN LED
+	 * (D505) hangs off the MT7592 (see &slot0).
+	 * Edge order from the power LED (D508): D501 D504 D510 D511 D512 D502
+	 * D506 D513 D505 D515 D514 D503.
+	 * TODO: D510 D511 D512 D502 D513 D515 (LAN on the GPHYs? 5 GHz? WPS?)
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
+		};
+
+		led_pon: led-1 {
+			/* D501, "PON" position (2nd from power) */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN;
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+		};
+
+		led_red: led-2 {
+			/* D504, red, "LOS" position (3rd from power) */
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_ALARM;
+			gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
+		};
+
+		led_phone: led-3 {
+			/* D506, phone (no VoIP in OpenWrt, so free to reassign) */
+			color = <LED_COLOR_ID_GREEN>;
+			function = "phone";
+			gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
+		};
+
+		led_internet: led-4 {
+			/* D503, "Internet" in the stock table */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN_ONLINE;
+			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
+		};
+
+		led_usb: led-5 {
+			/* D514, USB */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_USB;
