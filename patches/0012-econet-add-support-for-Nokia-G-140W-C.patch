diff --git a/target/linux/econet/base-files/etc/init.d/bootcount b/target/linux/econet/base-files/etc/init.d/bootcount
new file mode 100755
index 0000000000..0d91529afb
--- /dev/null
+++ b/target/linux/econet/base-files/etc/init.d/bootcount
@@ -0,0 +1,14 @@
+#!/bin/sh /etc/rc.common
+# The tcboot bootloader adds 1 to boot_fail_num in the flag partition on
+# every power-up and switches to the other firmware slot when it reaches 9.
+# The stock firmware clears it once it has booted, so OpenWrt does the same:
+# rewriting the OpenWrt boot flag sets the count back to 0.
+
+START=99
+
+boot() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "nokia,g140w-c" ] || return 0
+	# Only when running from flash, not from a RAM-booted image
+	grep -q '^/dev/ubiblock' /proc/mounts || grep -q ' /rom ' /proc/mounts || return 0
+	/sbin/en75_chboot openwrt >/dev/null 2>&1
+}
diff --git a/target/linux/econet/base-files/lib/upgrade/platform.sh b/target/linux/econet/base-files/lib/upgrade/platform.sh
index 19c0072e63..9d32e50e8e 100644
--- a/target/linux/econet/base-files/lib/upgrade/platform.sh
+++ b/target/linux/econet/base-files/lib/upgrade/platform.sh
@@ -1,3 +1,152 @@
+# The Nokia G-140W-C's bootloader loads a second stage ("bootram", the one
+# with the bldr> prompt) from the firmware slot it boots. It sits after the
+# kernel and rootfs in the slot's TRX, and its length is in the TRX header.
+# Without it the bootloader crashes, and it only falls back to the other
+# slot after nine failed boots. The bootram is Nokia's code, so the image
+# can't carry it: copy it from the router, from slot A or else from the stock
+# firmware in slot B, and put it after the kernel.
+G140WC_TRX_MAGIC=$((0x32524448))	# "2RDH"
+G140WC_BOOTRAM_OFS=$((0x3e0000))
+G140WC_BOOTRAM_MAX=$((0x20000))
+
+# <file> <offset>: big-endian u32 at <offset>, a multiple of 4
+g140wc_get32() {
+	local v=$(dd if="$1" bs=4 skip=$(($2 / 4)) count=1 2>/dev/null | \
+		hexdump -v -e '1/1 "%02x"')
+
+	echo $((0x${v:-0}))
+}
+
+# <file> <offset> <value>: store a big-endian u32 at <offset>
+g140wc_put32() {
+	printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \
+		$(($3 >> 24 & 255)) $(($3 >> 16 & 255)) \
+		$(($3 >> 8 & 255)) $(($3 & 255)))" | \
+		dd of="$1" bs=4 seek=$(($2 / 4)) conv=notrunc 2>/dev/null
+}
+
+g140wc_mtd_size() {
+	local size=$(grep "\"$1\"" /proc/mtd | cut -d' ' -f2)
+
+	[ -n "$size" ] && echo $((0x$size))
+}
+
+# <partition> <offset> <length> <file>: copy bytes out of an MTD partition
+g140wc_mtd_read() {
+	local mtd=$(find_mtd_index "$1")
+	local ofs=$(($2 % 4096))
+	local tmp=/tmp/g140wc.chunk
+
+	[ -n "$mtd" ] || return 1
+	dd if=/dev/mtd$mtd of=$tmp bs=4096 skip=$(($2 / 4096)) \
+		count=$(((ofs + $3 + 4095) / 4096)) 2>/dev/null || return 1
+	tail -c +$((ofs + 1)) $tmp > $tmp.2
+	dd if=$tmp.2 of="$4" bs=$3 count=1 2>/dev/null
+	rm -f $tmp $tmp.2
+	[ "$(wc -c < "$4")" -eq "$3" ]
+}
+
+# <partition> <next partition> <file>: copy the bootram of the TRX at the
+# start of <partition>. It may lie in <next partition>, which follows it on
+# flash.
+g140wc_copy_bootram() {
+	local part="$1" next="$2" out="$3"
+	local hdr=/tmp/g140wc.hdr
+	local size len ofs
+
+	size=$(g140wc_mtd_size "$part")
+	[ -n "$size" ] || return 1
+	g140wc_mtd_read "$part" 0 256 $hdr || return 1
+	[ "$(g140wc_get32 $hdr 0)" = "$G140WC_TRX_MAGIC" ] || return 1
+	len=$(g140wc_get32 $hdr 148)
+	ofs=$((256 + $(g140wc_get32 $hdr 80) + $(g140wc_get32 $hdr 84)))
+	rm -f $hdr
+	[ "$len" -gt 0 ] && [ "$len" -le "$G140WC_BOOTRAM_MAX" ] || return 1
+
+	if [ $((ofs + len)) -gt "$size" ]; then
+		[ -n "$next" ] && [ "$ofs" -ge "$size" ] || return 1
+		part="$next"
+		ofs=$((ofs - size))
+	fi
+	g140wc_mtd_read "$part" "$ofs" "$len" "$out" || return 1
+
+	# LZMA, with the properties byte all known bootrams have
+	[ "$(dd if="$out" bs=1 count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')" = "5d" ]
+}
+
+g140wc_get_bootram() {
+	g140wc_copy_bootram tclinux_kernel "" "$1" ||
+		g140wc_copy_bootram kernel_slave rootfs_slave "$1"
+}
+
+# <sysupgrade image> <output tar>: the same image, with the bootram added to
+# the kernel at G140WC_BOOTRAM_OFS and the TRX header updated to match
+g140wc_add_bootram() {
+	local img="$1" out="$2"
+	local dir=/tmp/g140wc-upgrade
+	local board_dir kernel len
+
+	rm -rf $dir
+	mkdir -p $dir || return 1
+	g140wc_get_bootram $dir/bootram || {
+		echo "Can't find the bootloader's second stage (bootram) in slot A or B"
+		return 1
+	}
+	len=$(wc -c < $dir/bootram)
+
+	tar xf "$img" -C $dir || return 1
+	board_dir=$(cd $dir && ls -d sysupgrade-*)
+	kernel=$dir/$board_dir/kernel
+	[ -d "$dir/$board_dir" ] && [ -f "$kernel" ] && \
+	[ "$(g140wc_get32 $kernel 0)" = "$G140WC_TRX_MAGIC" ] || {
+		echo "The image has no TRX kernel"
+		return 1
+	}
+
+	# Everything from G140WC_BOOTRAM_OFS on must be padding
+	if dd if=$kernel bs=$G140WC_BOOTRAM_OFS skip=1 2>/dev/null | \
+	   hexdump -e '16/1 "%02x" "\n"' | \
+	   grep -q -v -e '^f\{32\}$' -e '^\*$'; then
+		echo "The kernel doesn't fit in front of the bootram"
+		return 1
+	fi
+
+	dd if=$kernel of=$kernel.new bs=$G140WC_BOOTRAM_OFS count=1 2>/dev/null
+	cat $dir/bootram >> $kernel.new
+	rm $dir/bootram
+	[ "$(wc -c < $kernel.new)" -eq $((G140WC_BOOTRAM_OFS + len)) ] || return 1
+
+	g140wc_put32 $kernel.new 8 $((G140WC_BOOTRAM_OFS + len))	# total
+	g140wc_put32 $kernel.new 80 $((G140WC_BOOTRAM_OFS - 256))	# kernel
+	g140wc_put32 $kernel.new 84 0					# rootfs
+	g140wc_put32 $kernel.new 148 $len				# bootram
+
+	# CRC-32/JAMCRC of everything after the header. gzip computes the
+	# CRC-32 and stores it little-endian in its trailer.
+	set -- $(dd if=$kernel.new bs=256 skip=1 2>/dev/null | gzip -1 -c | \
+		tail -c 8 | hexdump -n 4 -v -e '4/1 "%02x "')
+	[ $# = 4 ] || return 1
+	g140wc_put32 $kernel.new 12 $((0x$4$3$2$1 ^ 0xffffffff))
+	mv $kernel.new $kernel
+
+	tar cf "$out.tmp" -C $dir "$board_dir" || return 1
+	rm -rf $dir
+	mv "$out.tmp" "$out"
+}
+
+platform_pre_upgrade() {
+	case "$(board_name)" in
+	nokia,g140w-c)
+		# Runs before the switch to the ramfs, with all tools at hand.
+		# Boot slot A next, which matters when installing from a RAM
+		# boot, once the image is ready to be written there.
+		rm -f /tmp/g140wc-sysupgrade.tar
+		g140wc_add_bootram "$1" /tmp/g140wc-sysupgrade.tar && \
+			/sbin/en75_chboot openwrt
+		;;
+	esac
+}
+
 platform_check_image() {
 	local board=$(board_name)
 
@@ -9,6 +158,14 @@ platform_check_image() {
 	jiofiber,jcow414)
 		return 0
 		;;
+	nokia,g140w-c)
+		g140wc_get_bootram /tmp/g140wc.bootram || {
+			echo "Can't find the bootloader's second stage (bootram) in slot A or B"
+			return 1
+		}
+		rm -f /tmp/g140wc.bootram
+		return 0
+		;;
 	esac
 
 	return 1
@@ -26,5 +183,14 @@ platform_do_upgrade() {
 		CI_KERNPART="tclinux_kernel"
 		nand_do_upgrade "$1"
 		;;
+	nokia,g140w-c)
+		# Prepared by platform_pre_upgrade
+		[ -f /tmp/g140wc-sysupgrade.tar ] || {
+			echo "The image could not be prepared, not writing it"
+			return 1
+		}
+		CI_KERNPART="tclinux_kernel"
+		nand_do_upgrade /tmp/g140wc-sysupgrade.tar
+		;;
 	esac
 }
diff --git a/target/linux/econet/base-files/sbin/en75_chboot b/target/linux/econet/base-files/sbin/en75_chboot
index 165a3ebb7b..6a8968547f 100755
--- a/target/linux/econet/base-files/sbin/en75_chboot
+++ b/target/linux/econet/base-files/sbin/en75_chboot
@@ -128,6 +128,19 @@ main() {
         code_factory=000000000000000100000001000000010000000000000000
            read_mask=000000000000000X00000000000000000000000000000000
         ;;
+    nokia,g140w-c)
+        # tcboot flag words, as printed by the bootloader:
+        #   commit, next_active, image0_is_valid, image1_is_valid,
+        #   boot_fail_num, (unused)
+        # OpenWrt lives in image0 (tclinux), stock stays in image1 (slave).
+        part=$(part_named '"flag"')
+        offset_blocks=0
+        block_size=$((1024 * 128))
+        code_offset=0
+        code_openwrt=000000010000000000000001000000010000000000000000
+        code_factory=000000010000000100000001000000010000000000000000
+           read_mask=000000000000000X00000000000000000000000000000000
+        ;;
     smartfiber,xp8421-b)
         # 0dfc0000
         part=$(part_named '"reservearea"')
diff --git a/target/linux/econet/dts/en751221_nokia_g140w-c-bringup.dts b/target/linux/econet/dts/en751221_nokia_g140w-c-bringup.dts
new file mode 100644
index 0000000000..a9f635bf4c
--- /dev/null
+++ b/target/linux/econet/dts/en751221_nokia_g140w-c-bringup.dts
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+/dts-v1/;
+
+#include "en751221_nokia_g140w-c.dtsi"
+
+/*
+ * RAM-test image: the production device tree, except that slot A's UBI
+ * area is renamed, so OpenWrt doesn't attach and mount it at boot. A RAM
+ * boot then leaves an installed OpenWrt untouched. Not meant to be flashed.
+ */
+/ {
+	model = "Nokia G-140W-C (RAM test)";
+	compatible = "nokia,g140w-c-bringup", "econet,en751221";
+};
+
+/* Bootloader log: "bmt pool size: 163". Abort BMT setup if we disagree. */
+&nand {
+	econet,assert-reserve-size = <163>;
+};
+
+&slot_a_ubi {
+	label = "ubi_slot_a";
+};
