diff --git a/target/linux/econet/base-files/etc/init.d/bootcount b/target/linux/econet/base-files/etc/init.d/bootcount
new file mode 100755
index 0000000000..473ee24ebc
--- /dev/null
+++ b/target/linux/econet/base-files/etc/init.d/bootcount
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+# SPDX-License-Identifier: GPL-2.0-only
+# The tcboot bootloader adds 1 to boot_fail_num in the flag partition on
+# every power-up and switches to the other firmware slot when it reaches 9.
+# The stock firmware clears it once it has booted, so OpenWrt does the same:
+# rewriting the OpenWrt boot flag sets the count back to 0.
+
+START=99
+
+boot() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "nokia,g140w-c" ] || return 0
+	# Only when running from flash, not from a RAM-booted image
+	grep -q '^/dev/ubiblock' /proc/mounts || grep -q ' /rom ' /proc/mounts || return 0
+	/sbin/en75_chboot openwrt >/dev/null 2>&1
+}
diff --git a/target/linux/econet/base-files/lib/upgrade/nokia.sh b/target/linux/econet/base-files/lib/upgrade/nokia.sh
new file mode 100644
index 0000000000..97e68ffc56
--- /dev/null
+++ b/target/linux/econet/base-files/lib/upgrade/nokia.sh
@@ -0,0 +1,221 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+# The Nokia G-140W-C's bootloader loads a second stage ("bootram", the one
+# with the bldr> prompt) from the firmware slot it boots. It sits after the
+# kernel and rootfs in the slot's TRX, and its length is in the TRX header.
+# Without it the bootloader crashes, and it only falls back to the other
+# slot after nine failed boots. The bootram is Nokia's code, so the image
+# can't carry it: copy it from the router, from slot A or else from the stock
+# firmware in slot B, and put it after the kernel.
+G140WC_TRX_MAGIC=$((0x32524448))	# "2RDH"
+G140WC_BOOTRAM_OFS=$((0x3e0000))
+G140WC_BOOTRAM_MAX=$((0x20000))
+
+# <file> <offset>: big-endian u32 at <offset>, a multiple of 4
+g140wc_get32() {
+	local v=$(dd if="$1" bs=4 skip=$(($2 / 4)) count=1 2>/dev/null | \
+		hexdump -v -e '1/1 "%02x"')
+
+	echo $((0x${v:-0}))
+}
+
+# <file> <offset> <value>: store a big-endian u32 at <offset>
+g140wc_put32() {
+	printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \
+		$(($3 >> 24 & 255)) $(($3 >> 16 & 255)) \
+		$(($3 >> 8 & 255)) $(($3 & 255)))" | \
+		dd of="$1" bs=4 seek=$(($2 / 4)) conv=notrunc 2>/dev/null
+}
+
+g140wc_mtd_size() {
+	local size=$(grep "\"$1\"" /proc/mtd | cut -d' ' -f2)
+
+	[ -n "$size" ] && echo $((0x$size))
+}
+
+# <partition> <offset> <length> <file>: copy bytes out of an MTD partition
+g140wc_mtd_read() {
+	local mtd=$(find_mtd_index "$1")
+	local ofs=$(($2 % 4096))
+	local tmp=/tmp/g140wc.chunk
+
+	[ -n "$mtd" ] || return 1
+	dd if=/dev/mtd$mtd of=$tmp bs=4096 skip=$(($2 / 4096)) \
+		count=$(((ofs + $3 + 4095) / 4096)) 2>/dev/null || return 1
+	tail -c +$((ofs + 1)) $tmp > $tmp.2
+	dd if=$tmp.2 of="$4" bs=$3 count=1 2>/dev/null
+	rm -f $tmp $tmp.2
+	[ "$(wc -c < "$4")" -eq "$3" ]
+}
+
+# <partition> <next partition> <file>: copy the bootram of the TRX at the
+# start of <partition>. It may lie in <next partition>, which follows it on
+# flash.
+g140wc_copy_bootram() {
+	local part="$1" next="$2" out="$3"
+	local hdr=/tmp/g140wc.hdr
+	local size len ofs
+
+	size=$(g140wc_mtd_size "$part")
+	[ -n "$size" ] || return 1
+	g140wc_mtd_read "$part" 0 256 $hdr || return 1
+	[ "$(g140wc_get32 $hdr 0)" = "$G140WC_TRX_MAGIC" ] || return 1
+	len=$(g140wc_get32 $hdr 148)
+	ofs=$((256 + $(g140wc_get32 $hdr 80) + $(g140wc_get32 $hdr 84)))
+	rm -f $hdr
+	[ "$len" -gt 0 ] && [ "$len" -le "$G140WC_BOOTRAM_MAX" ] || return 1
+
+	if [ $((ofs + len)) -gt "$size" ]; then
+		[ -n "$next" ] && [ "$ofs" -ge "$size" ] || return 1
+		part="$next"
+		ofs=$((ofs - size))
+	fi
+	g140wc_mtd_read "$part" "$ofs" "$len" "$out" || return 1
+
+	# LZMA, with the properties byte all known bootrams have
+	[ "$(dd if="$out" bs=1 count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')" = "5d" ]
+}
+
+g140wc_get_bootram() {
+	g140wc_copy_bootram tclinux_kernel "" "$1" ||
+		g140wc_copy_bootram kernel_slave rootfs_slave "$1"
+}
+
+# <sysupgrade image> <output tar>: the same image, with the bootram added to
+# the kernel at G140WC_BOOTRAM_OFS and the TRX header updated to match
+g140wc_add_bootram() {
+	local img="$1" out="$2"
+	local dir=/tmp/g140wc-upgrade
+	local board_dir kernel len
+
+	rm -rf $dir
+	mkdir -p $dir || return 1
+	g140wc_get_bootram $dir/bootram || {
+		echo "Can't find the bootloader's second stage (bootram) in slot A or B"
+		return 1
+	}
+	len=$(wc -c < $dir/bootram)
+
+	tar xf "$img" -C $dir || return 1
+	board_dir=$(cd $dir && ls -d sysupgrade-*)
+	kernel=$dir/$board_dir/kernel
+	[ -d "$dir/$board_dir" ] && [ -f "$kernel" ] && \
+	[ "$(g140wc_get32 $kernel 0)" = "$G140WC_TRX_MAGIC" ] || {
+		echo "The image has no TRX kernel"
+		return 1
+	}
+
+	# Everything from G140WC_BOOTRAM_OFS on must be padding
+	if dd if=$kernel bs=$G140WC_BOOTRAM_OFS skip=1 2>/dev/null | \
+	   hexdump -e '16/1 "%02x" "\n"' | \
+	   grep -q -v -e '^f\{32\}$' -e '^\*$'; then
+		echo "The kernel doesn't fit in front of the bootram"
+		return 1
+	fi
+
+	dd if=$kernel of=$kernel.new bs=$G140WC_BOOTRAM_OFS count=1 2>/dev/null
+	cat $dir/bootram >> $kernel.new
+	rm $dir/bootram
+	[ "$(wc -c < $kernel.new)" -eq $((G140WC_BOOTRAM_OFS + len)) ] || return 1
+
+	g140wc_put32 $kernel.new 8 $((G140WC_BOOTRAM_OFS + len))	# total
+	g140wc_put32 $kernel.new 80 $((G140WC_BOOTRAM_OFS - 256))	# kernel
+	g140wc_put32 $kernel.new 84 0					# rootfs
+	g140wc_put32 $kernel.new 148 $len				# bootram
+
+	# CRC-32/JAMCRC of everything after the header. gzip computes the
+	# CRC-32 and stores it little-endian in its trailer.
+	set -- $(dd if=$kernel.new bs=256 skip=1 2>/dev/null | gzip -1 -c | \
+		tail -c 8 | hexdump -n 4 -v -e '4/1 "%02x "')
+	[ $# = 4 ] || return 1
+	g140wc_put32 $kernel.new 12 $((0x$4$3$2$1 ^ 0xffffffff))
+	mv $kernel.new $kernel
+
+	tar cf "$out.tmp" -C $dir "$board_dir" || return 1
+	rm -rf $dir
+	mv "$out.tmp" "$out"
+}
+
+# The stock firmware keeps the Wi-Fi calibration, one EEPROM table per
+# radio, as files on its UBIFS "config" partition, which the Wi-Fi driver
+# can't read. OpenWrt keeps a copy in a static UBI volume next to its root,
+# which the device tree hands to the driver: the 2.4 GHz table at 0x0,
+# padded with zeros to the 1 KiB the mt7603 driver reads, and the 5 GHz
+# table at 0x400.
+G140WC_CAL_VOL=calibration
+G140WC_CAL_SIZE=1536
+
+# <file> <offset>: the two bytes at <offset> (an even number) in hex
+g140wc_get16() {
+	dd if="$1" bs=2 skip=$(($2 / 2)) count=1 2>/dev/null | \
+		hexdump -v -e '1/1 "%02x"'
+}
+
+# <file>: check a calibration volume image by its size and chip IDs
+g140wc_check_cal() {
+	[ "$(wc -c < "$1")" -eq $G140WC_CAL_SIZE ] || return 1
+	case "$(g140wc_get16 "$1" 0)" in
+	9275|0376|0076|2876) ;;
+	*) return 1 ;;
+	esac
+	case "$(g140wc_get16 "$1" 1024)" in
+	6276|1276) ;;
+	*) return 1 ;;
+	esac
+}
+
+g140wc_has_cal() {
+	local ubi=$(nand_find_ubi "$CI_UBIPART")
+
+	[ -n "$ubi" ] && [ -n "$(nand_find_volume $ubi $G140WC_CAL_VOL)" ]
+}
+
+# <file>: build the calibration volume image from the stock settings. The
+# "config" partition is read-only in the device tree, so UBI attaches it
+# read-only; refuse to attach it otherwise.
+g140wc_cal_from_stock() {
+	local out="$1"
+	local mtd=$(find_mtd_index config)
+	local dir=/tmp/g140wc-config
+	local ubi ret=1
+
+	[ -n "$mtd" ] || return 1
+	[ $(($(cat /sys/class/mtd/mtd$mtd/flags) & 0x400)) -eq 0 ] || return 1
+	[ -z "$(nand_find_ubi config)" ] || return 1
+	ubiattach -m $mtd > /dev/null 2>&1 || return 1
+	ubi=$(nand_find_ubi config)
+
+	mkdir -p $dir
+	if [ -n "$ubi" ] && mount -t ubifs -o ro ${ubi}_0 $dir 2>/dev/null; then
+		[ -f $dir/RT30xxEEPROM.bin ] && \
+		[ -f $dir/bin_ac/RT30xxEEPROM.bin ] && {
+			dd if=$dir/RT30xxEEPROM.bin bs=512 count=1
+			dd if=/dev/zero bs=512 count=1
+			dd if=$dir/bin_ac/RT30xxEEPROM.bin bs=512 count=1
+		} 2>/dev/null > "$out" && g140wc_check_cal "$out" && ret=0
+		umount $dir
+	fi
+	rmdir $dir
+	ubidetach -m $mtd > /dev/null 2>&1
+	[ $ret = 0 ] || rm -f "$out"
+	return $ret
+}
+
+# <file>: create the calibration volume. This runs on the ramfs, before
+# nand_do_upgrade creates rootfs_data from all the free space. If rootfs_data
+# is there, remove it first: nand_do_upgrade recreates it, and the settings
+# to keep are saved in /tmp. The volume ID is the second-to-last one, so the
+# other volumes keep their usual IDs.
+g140wc_store_cal() {
+	local ubi vol
+
+	ubi=$(nand_attach_ubi "$CI_UBIPART") || return 1
+	[ -n "$(nand_find_volume $ubi $G140WC_CAL_VOL)" ] && return 0
+	if [ -n "$(nand_find_volume $ubi rootfs_data)" ]; then
+		ubirmvol /dev/$ubi -N rootfs_data || return 1
+	fi
+	ubimkvol /dev/$ubi -N $G140WC_CAL_VOL -t static -s $G140WC_CAL_SIZE \
+		-n $(($(cat /sys/class/ubi/$ubi/max_vol_count) - 2)) || return 1
+	vol=$(nand_find_volume $ubi $G140WC_CAL_VOL)
+	[ -n "$vol" ] && ubiupdatevol /dev/$vol "$1"
+}
diff --git a/target/linux/econet/base-files/lib/upgrade/platform.sh b/target/linux/econet/base-files/lib/upgrade/platform.sh
index 19c0072e63..e532b5ce78 100644
--- a/target/linux/econet/base-files/lib/upgrade/platform.sh
+++ b/target/linux/econet/base-files/lib/upgrade/platform.sh
@@ -9,11 +9,34 @@ platform_check_image() {
 	jiofiber,jcow414)
 		return 0
 		;;
+	nokia,g140w-c)
+		g140wc_get_bootram /tmp/g140wc.bootram || {
+			echo "Can't find the bootloader's second stage (bootram) in slot A or B"
+			return 1
+		}
+		rm -f /tmp/g140wc.bootram
+		return 0
+		;;
 	esac
 
 	return 1
 }
 
+platform_pre_upgrade() {
+	case "$(board_name)" in
+	nokia,g140w-c)
+		# Runs before the switch to the ramfs, with all tools at hand.
+		# Boot slot A next, which matters when installing from a RAM
+		# boot, once the image is ready to be written there.
+		rm -f /tmp/g140wc-sysupgrade.tar /tmp/g140wc-cal.bin
+		g140wc_add_bootram "$1" /tmp/g140wc-sysupgrade.tar || return
+		g140wc_has_cal || g140wc_cal_from_stock /tmp/g140wc-cal.bin || \
+			echo "No Wi-Fi calibration found, Wi-Fi will stay off"
+		/sbin/en75_chboot openwrt
+		;;
+	esac
+}
+
 platform_do_upgrade() {
 	local board=$(board_name)
 
@@ -26,5 +49,18 @@ platform_do_upgrade() {
 		CI_KERNPART="tclinux_kernel"
 		nand_do_upgrade "$1"
 		;;
+	nokia,g140w-c)
+		# Prepared by platform_pre_upgrade
+		[ -f /tmp/g140wc-sysupgrade.tar ] || {
+			echo "The image could not be prepared, not writing it"
+			return 1
+		}
+		CI_KERNPART="tclinux_kernel"
+		if [ -f /tmp/g140wc-cal.bin ]; then
+			g140wc_store_cal /tmp/g140wc-cal.bin || \
+				echo "Could not store the Wi-Fi calibration"
+		fi
+		nand_do_upgrade /tmp/g140wc-sysupgrade.tar
+		;;
 	esac
 }
diff --git a/target/linux/econet/base-files/sbin/en75_chboot b/target/linux/econet/base-files/sbin/en75_chboot
index 165a3ebb7b..6a8968547f 100755
--- a/target/linux/econet/base-files/sbin/en75_chboot
+++ b/target/linux/econet/base-files/sbin/en75_chboot
@@ -128,6 +128,19 @@ main() {
         code_factory=000000000000000100000001000000010000000000000000
            read_mask=000000000000000X00000000000000000000000000000000
         ;;
+    nokia,g140w-c)
+        # tcboot flag words, as printed by the bootloader:
+        #   commit, next_active, image0_is_valid, image1_is_valid,
+        #   boot_fail_num, (unused)
+        # OpenWrt lives in image0 (tclinux), stock stays in image1 (slave).
+        part=$(part_named '"flag"')
+        offset_blocks=0
+        block_size=$((1024 * 128))
+        code_offset=0
+        code_openwrt=000000010000000000000001000000010000000000000000
+        code_factory=000000010000000100000001000000010000000000000000
+           read_mask=000000000000000X00000000000000000000000000000000
+        ;;
     smartfiber,xp8421-b)
         # 0dfc0000
         part=$(part_named '"reservearea"')
diff --git a/target/linux/econet/dts/en751221_nokia_g140w-c.dts b/target/linux/econet/dts/en751221_nokia_g140w-c.dts
new file mode 100644
index 0000000000..5caf587647
--- /dev/null
+++ b/target/linux/econet/dts/en751221_nokia_g140w-c.dts
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Nokia G-140W-C (EcoNet EN7526G, 512 MiB DDR3, 256 MiB SPI-NAND W25M02GV,
+ * MT7592 + MT7612E)
+ *
+ * Derived from en751221_nokia_g240g-e.dts, which has an identical flash
+ * layout.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "en751221.dtsi"
+
+/ {
+	model = "Nokia G-140W-C";
+	compatible = "nokia,g140w-c", "econet,en751221";
+
+	/*
+	 * 512 MiB DDR3 fitted, but only the part below the 0x1c000000 I/O
+	 * window is reachable; the stock kernel uses 0x0-0x1b800000 (440 MiB).
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x1b800000>;
+	};
+
+	chosen {
+		stdout-path = "/serial@1fbf0000:115200";
+		linux,usable-memory-range = <0x00020000 0x1b7e0000>;
+	};
+
+	aliases {
+		led-boot = &led_power;
+		led-failsafe = &led_red;
+		led-running = &led_power;
+		led-upgrade = &led_pon;
+	};
+
+	/*
+	 * The stock led_drv.ko/gpio_mgr.ko have a table for this board
+	 * ("G140WC"): power GPIO 6, PON GPIO 2, LOS GPIO 24, Internet GPIO 28,
+	 * phone GPIO 25 (LED id 9, used by the SIP app) and USB GPIO 11 (LED
+	 * ids 15/67, used by the USB notifier). All active-low; each one was
+	 * lit from Linux and matched to its D-number on the PCB. GPIO 27 is the
+	 * PON laser TX-disable line and must stay alone. The 2.4 GHz WLAN LED
+	 * (D505) hangs off the MT7592 (see &slot0).
+	 * Edge order from the power LED (D508): D501 D504 D510 D511 D512 D502
+	 * D506 D513 D505 D515 D514 D503.
+	 * D510, D511, D512, D502, D513 and D515 are not on SoC GPIOs.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
+		};
+
+		led_pon: led-1 {
+			/* D501, "PON" position (2nd from power) */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN;
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+		};
+
+		led_red: led-2 {
+			/* D504, red, "LOS" position (3rd from power) */
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_ALARM;
+			gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
+		};
+
+		led_phone: led-3 {
+			/* D506, phone (no VoIP in OpenWrt, so free to reassign) */
+			color = <LED_COLOR_ID_GREEN>;
+			function = "phone";
+			gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
+		};
+
+		led_internet: led-4 {
+			/* D503, "Internet" in the stock table */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN_ONLINE;
+			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
+		};
+
+		led_usb: led-5 {
+			/* D514, USB */
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_USB;
+			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/*
+	 * From the stock button_driver.ko table for this board: reset on GPIO 0
+	 * and an "LED" (lights on/off) button on GPIO 5, both idle high. The
+	 * WLAN and WPS buttons are wired to the Wi-Fi chip, which mt76 cannot
+	 * read.
+	 */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		key-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+		};
+
+		key-lights {
+			label = "lights";
+			linux,code = <KEY_LIGHTS_TOGGLE>;
+			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&nand {
+	status = "okay";
+	econet,bmt;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x0 0x40000>;
+			read-only;
+		};
+
+		partition@40000 {
+			label = "romfile";
+			reg = <0x40000 0x40000>;
+		};
+
+		/*
+		 * Slot A (stock "linux" / "image0"). The bootloader writes the
+		 * factory image across all of it; OpenWrt splits it into a raw
+		 * TRX kernel and a UBI area holding rootfs + rootfs_data.
+		 * Slot B ("kernel_slave"/"rootfs_slave") keeps the stock firmware.
+		 *
+		 * Slot A has no econet,enable-remap. With it, a read error in
+		 * old stock data makes the BMT driver remap the block, and the
+		 * bootloader redoes such a remap on every boot once UBI has
+		 * erased the replacement block and its mapping mark, which
+		 * wipes UBI data. Test images had remapped blocks 36-58 of the
+		 * reference unit that way, so UBI starts after them, at block 59.
+		 */
+		partition@80000 {
+			label = "tclinux";
+			reg = <0x80000 0x2200000>;
+		};
+
+		partition1@80000 {
+			label = "tclinux_kernel";
+			reg = <0x80000 0x400000>;
+		};
+
+		partition@760000 {
+			label = "ubi";
+			reg = <0x760000 0x1b20000>;
+
+			volumes {
+				ubi-volume-calibration {
+					volname = "calibration";
+
+					nvmem-layout {
+						compatible = "fixed-layout";
+						#address-cells = <1>;
+						#size-cells = <1>;
+
+						eeprom_cal_2g: eeprom@0 {
+							reg = <0x0 0x400>;
+						};
+
+						eeprom_cal_5g: eeprom@400 {
+							reg = <0x400 0x200>;
+						};
+					};
+				};
+			};
+		};
+
+		/* Stock firmware stays here: fallback via the bootloader flag */
+		partition@2280000 {
+			label = "kernel_slave";
+			reg = <0x2280000 0x300000>;
+			read-only;
+		};
+
+		partition@2580000 {
+			label = "rootfs_slave";
+			reg = <0x2580000 0x1f00000>;
+			read-only;
+		};
+
+		partition@4480000 {
+			label = "kernel_oflt";
+			reg = <0x4480000 0x300000>;
+			read-only;
+		};
+
+		partition@4780000 {
+			label = "rootfs_oflt";
+			reg = <0x4780000 0xc00000>;
+			read-only;
+		};
+
+		partition@5380000 {
+			label = "config";
+			reg = <0x5380000 0x800000>;
+			read-only;
+		};
+
+		partition@5b80000 {
+			label = "log";
+			reg = <0x5b80000 0xc00000>;
+		};
+
+		partition@6780000 {
+			label = "extfs";
+			reg = <0x6780000 0x600000>;
+		};
+
+		partition@6d80000 {
+			label = "bosa";
+			reg = <0x6d80000 0x40000>;
+			read-only;
+		};
+
+		partition@6dc0000 {
+			label = "flag";
+			reg = <0x6dc0000 0x40000>;
+		};
+
+		partition@6e00000 {
+			label = "flagback";
+			reg = <0x6e00000 0x40000>;
+		};
+
+		partition@6e40000 {
+			label = "ri";
+			reg = <0x6e40000 0x40000>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				/* Base MAC: the same value ritool reports as MACAddress */
+				macaddr_ri_3e: macaddr@3e {
+					compatible = "mac-base";
+					reg = <0x3e 0x6>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		partition@6e80000 {
+			label = "riback";
+			reg = <0x6e80000 0x40000>;
+			read-only;
+		};
+	};
+};
+
+&gmac0 {
+	status = "okay";
+	nvmem-cells = <&macaddr_ri_3e 0>;
+	nvmem-cell-names = "mac-address";
+};
+
+/*
+ * Radio placement confirmed from the stock boot log: MT7592 (14c3:7603) on
+ * PCIe RC0, MT7612E (14c3:7662, 64-bit BAR) on the Gen2 RC1.
+ *
+ * Their calibration comes from the "calibration" UBI volume, which
+ * sysupgrade fills from the stock settings (see platform.sh).
+ */
+&pcie0 {
+	status = "okay";
+};
+
+&slot0 {
+	wifi@0,0 {
+		/* MT7592 2.4 GHz (mt7603 driver); stock used base MAC + 0x9 */
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		nvmem-cells = <&eeprom_cal_2g>, <&macaddr_ri_3e 9>;
+		nvmem-cell-names = "eeprom", "mac-address";
+
+		/* LED pin 0 drives the front WLAN LED; it is active-low */
+		led {
+			led-active-low;
+		};
+	};
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&slot1 {
+	wifi@0,0 {
+		/* MT7612E 5 GHz; stock used base MAC + 0xd */
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		nvmem-cells = <&eeprom_cal_5g>, <&macaddr_ri_3e 13>;
+		nvmem-cell-names = "eeprom", "mac-address";
+	};
+};
+
+/*
+ * The LAN sockets are on the MT7530 multi-chip module inside the EN7526G
+ * (CREV 0x75300001, MDIO address 31), not on the on-die switch at
+ * 0x1fb58000. The MT7530's port 6 is linked over TRGMII to port 5 of the
+ * on-die switch, which econet-eth keeps as a dumb switch between it and the
+ * frame engine (port 6). The MDIO bus is the on-die switch's PHY access
+ * controller; the on-die switch's own PHYs at 8-11 are not wired to sockets.
+ *
+ * LAN1-LAN4 are MT7530 ports 1-4 (LAN2 and LAN4 checked with the port
+ * counters, matching the stock port map). Port 0 has a PHY but no socket.
+ *
+ * There is no reset line for the module, and the bootloader sets up the
+ * TRGMII link (200 MHz clock, its own pad tuning). The econet compatible
+ * makes the mt7530 driver keep that set-up.
+ */
+&switch0 {
+	compatible = "econet,en751221-mt7530", "mediatek,mt7530";
+	/delete-property/ mediatek,mcm;
+	/delete-property/ reset-names;
+
+	ports {
+		port@1 {
+			status = "okay";
+			label = "lan1";
+			phy-mode = "gmii";
+			phy-handle = <&swphy1>;
+		};
+
+		port@2 {
+			status = "okay";
+			label = "lan2";
+			phy-mode = "gmii";
+			phy-handle = <&swphy2>;
+		};
+
+		port@3 {
+			status = "okay";
+			label = "lan3";
+			phy-mode = "gmii";
+			phy-handle = <&swphy3>;
+		};
+
+		port@4 {
+			reg = <4>;
+			label = "lan4";
+			phy-mode = "gmii";
+			phy-handle = <&swphy4>;
+		};
+	};
+
+	mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		swphy1: ethernet-phy@1 {
+			reg = <1>;
+		};
+
+		swphy2: ethernet-phy@2 {
+			reg = <2>;
+		};
+
+		swphy3: ethernet-phy@3 {
+			reg = <3>;
+		};
+
+		swphy4: ethernet-phy@4 {
+			reg = <4>;
+		};
+	};
+};
diff --git a/target/linux/econet/image/en751221.mk b/target/linux/econet/image/en751221.mk
index ec96a5ac20..79a131448f 100644
--- a/target/linux/econet/image/en751221.mk
+++ b/target/linux/econet/image/en751221.mk
@@ -54,6 +54,30 @@ define Device/nokia_g240g-e
 endef
 TARGET_DEVICES += nokia_g240g-e
 
+# Kernel in a raw TRX at the start of slot A, squashfs + overlay in UBI after
+# it (same scheme as the JioFiber/GS3101 boards), so sysupgrade and persistent
+# settings work. The stock tcboot is a "free bootbase" build (decompAddr
+# 0x80002000 in the factory TRX), hence the jump stub.
+define Device/nokia_g140w-c
+  $(call Device/tclinux-ubi)
+  DEVICE_VENDOR := Nokia
+  DEVICE_MODEL := G-140W-C
+  DEVICE_DTS := en751221_nokia_g140w-c
+  # No tclinux.trx: slot A also needs the bootloader's second stage, which
+  # only the router has, and UBI starts at 0x760000. sysupgrade from the
+  # RAM-booted initramfs installs it (see platform.sh).
+  IMAGES := sysupgrade.bin
+  TRX_LOADADDR := 0x80002000
+  KERNEL := kernel-bin | append-dtb | tclinux-free-bootbase-jump | lzma | \
+    kernel-trx
+  # RAM boot: tcboot's xmdm loads the image at 0x80020000 and the kernel
+  # decompresses to 0x81000000, so the loader (image, 1 MiB DTB slot and
+  # 4 MiB heap) has to end below that.
+  KERNEL_INITRAMFS := kernel-bin | append-dtb | check-size 11394032
+  DEVICE_PACKAGES := kmod-usb3 kmod-mt7603 kmod-mt76x2 wpad-basic-mbedtls
+endef
+TARGET_DEVICES += nokia_g140w-c
+
 define Device/smartfiber_xp8421-b
   DEVICE_VENDOR := SmartFiber
   DEVICE_MODEL := XP8421-B
