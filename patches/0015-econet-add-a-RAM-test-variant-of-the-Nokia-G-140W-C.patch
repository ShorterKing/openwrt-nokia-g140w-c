From d4b189a17309a11fb153d7afeeebd2445d30dfc7 Mon Sep 17 00:00:00 2001
From: ShorterKing <84120105+ShorterKing@users.noreply.github.com>
Date: Sun, 15 Nov 2026 08:21:40 +0000
Subject: [PATCH 15/16] econet: add a RAM-test variant of the Nokia G-140W-C

A RAM-boot image for trying OpenWrt without touching the flash: the
production device tree with slot A's UBI area renamed, so it is neither
attached nor mounted, and a check of the vendor BMT pool size. Since it
can't use the calibration volume, it embeds the reference unit's Wi-Fi
calibration. sysupgrade refuses to run on it.

Not meant for upstream: it exists for the RAM boot guide of this port.
---
 .../econet/base-files/etc/board.d/01_leds     |   3 +-
 .../econet/base-files/etc/board.d/02_network  |   6 +-
 .../dts/en751221_nokia_g140w-c-bringup.dts    | 103 ++++++++++++++++++
 .../econet/dts/en751221_nokia_g140w-c.dts     |   6 +-
 target/linux/econet/image/en751221.mk         |  11 ++
 5 files changed, 123 insertions(+), 6 deletions(-)
 create mode 100644 target/linux/econet/dts/en751221_nokia_g140w-c-bringup.dts

diff --git a/target/linux/econet/base-files/etc/board.d/01_leds b/target/linux/econet/base-files/etc/board.d/01_leds
index 6725bb939e..82be82362d 100644
--- a/target/linux/econet/base-files/etc/board.d/01_leds
+++ b/target/linux/econet/base-files/etc/board.d/01_leds
@@ -35,7 +35,8 @@ jiofiber,jcow414)
 	ucidef_set_led_netdev "lan3-green" "lan3" "mt7530-0:0b:green:lan-3" "lan3" "tx rx"
 	ucidef_set_led_netdev "lan4-green" "lan4" "mt7530-0:0c:green:lan-4" "lan4" "tx rx"
 	;;
-nokia,g140w-c)
+nokia,g140w-c|\
+nokia,g140w-c-bringup)
 	ucidef_set_led_netdev "wan" "WAN" "green:wan" "lan4" "link"
 	ucidef_set_led_netdev "internet" "Internet" "green:wan-online" "lan4" "link tx rx"
